# Required. SEC EDGAR fair-access User-Agent: "Name email@example.com"
SEC_USER_AGENT=Your Name you@example.com

# SQLite database path (relative to project root or absolute)
DATABASE_URL=sqlite:///./data/secpulse.db

# Poll interval for current filings Atom feed (seconds)
POLL_INTERVAL_SECONDS=30

# Max SEC.gov requests per second (fair-access guideline is 10; we cap lower)
SEC_MAX_REQUESTS_PER_SECOND=8

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
