# Required. SEC EDGAR fair-access User-Agent: "Name email@example.com"
SEC_USER_AGENT=Your Name you@example.com

# SQLite database path (relative to project root or absolute)
DATABASE_URL=sqlite:///./data/secpulse.db

# Poll interval for current filings Atom feed (seconds)
POLL_INTERVAL_SECONDS=30

# Max SEC.gov requests per second (fair-access guideline is 10; we cap lower)
SEC_MAX_REQUESTS_PER_SECOND=8

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Approx token budget for 8-K / SC 13D combined text (Ollama prompts)
TOKEN_BUDGET=4000

# Local Ollama (required for scoring; filings queue if Ollama is down)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# Alert when direction != neutral AND confidence >= this value
ALERT_THRESHOLD=65

# Dev / ops (optional)
# SECPULSE_DISABLE_BACKGROUND=1   # skip Atom poller (tests)
# SECPULSE_SKIP_FRONTEND=1        # don't mount frontend/dist (Vite proxy mode)

# Comma-separated origins for a static Netlify UI calling this API (optional)
# CORS_ORIGINS=https://your-site.netlify.app,http://localhost:5173

# Patent watch (optional). Without this key EDGAR keeps running; patent poller stays off.
# Get a key: https://data.uspto.gov/apis  → set X-API-KEY as USPTO_API_KEY
# USPTO_API_KEY=
# USPTO_POLL_INTERVAL_SECONDS=600
# USPTO_MAX_REQUESTS_PER_SECOND=1
# ASSIGNEE_ALIAS_PATH=./data/assignee_aliases.json

